<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" styleClass="main-bg" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="MediaVaultController">
   <children>
      <VBox alignment="CENTER" layoutX="153.0" prefHeight="400.0" prefWidth="301.0" spacing="15.0">
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <children>
            <Label alignment="CENTER" styleClass="title-label" stylesheets="@style.css" text="MediaVault" textAlignment="CENTER" textFill="WHITE" />
            <TextField maxWidth="-Infinity" prefHeight="25.0" prefWidth="200.0" promptText="Username">
               <font>
                  <Font name="Calibri" size="12.0" />
               </font>
            </TextField>
            <Button mnemonicParsing="false" styleClass="enter-button" stylesheets="@style.css" text="Enter" textFill="WHITE" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
